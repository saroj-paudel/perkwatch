# --- App ---
APP_URL=http://localhost:3000
OWNER_EMAIL=you@example.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser. Used by cron and the Telegram webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini API / Gemma 4 ---
GEMINI_API_KEY=your-gemini-api-key
# Look up the exact Gemma 4 model ID in the Gemini API docs. Do not guess.
GEMMA_MODEL_ID=
AI_DAILY_LIMIT=30

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=your_bot_username
# Any long random string. Sent back by Telegram in a header on every webhook call.
TELEGRAM_WEBHOOK_SECRET=change-me-long-random

# --- Scheduler ---
# Any long random string. The cron route requires: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-long-random
